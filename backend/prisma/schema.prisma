generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

// Ciclo de vida simplificado (entrega porta a porta pelo agente parceiro)
enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  PROCESSING_SUPPLIER
  IN_INTERNATIONAL_TRANSIT
  ARRIVED_IN_ANGOLA
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  REVIEW_PENDING
  APPROVED
  DECLINED
  REFUNDED
}

enum ShipmentStatus {
  DRAFT
  ORIGIN_WAREHOUSE
  INTERNATIONAL_TRANSIT
  ARRIVED
  DISTRIBUTION
  DELIVERED
}

enum OrderChannel {
  WEB
  WHATSAPP
  ADMIN
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
  SIMULATED
}

enum ConversationStatus {
  BOT
  HUMAN
  CLOSED
}

enum TransportMode {
  AIR
  SEA
  LAND
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  role         UserRole             @default(CUSTOMER)
  active       Boolean              @default(true)
  lastLoginAt  DateTime?
  // Sessões (JWT) emitidas antes desta data deixam de ser aceites
  passwordChangedAt DateTime?
  customer     Customer?
  resetTokens  PasswordResetToken[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Customer {
  id        String    @id @default(cuid())
  userId    String    @unique
  firstName String
  lastName  String
  phone     String?
  nif       String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
  orders    Order[]
  favorites String[]  @default([])
  cart      Cart?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id            String   @id @default(cuid())
  customerId    String
  label         String?
  recipientName String
  phone         String
  province      String   @default("Luanda")
  municipality  String
  street        String
  reference     String?
  country       String   @default("AO")
  isDefault     Boolean  @default(false)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String?
  priceAoa    Decimal     @db.Decimal(14, 2)
  unit        String      @default("unidade")
  moq         String?
  origin      String?
  badge       String?
  specs       String?
  image       String?
  images      Json        @default("[]")
  techSpecs   Json        @default("[]")
  logistics   Json        @default("{}")
  active      Boolean     @default(true)
  featured    Boolean     @default(false)
  immediateAvailable Boolean @default(false)
  chargeShipping     Boolean @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  orderItems  OrderItem[]
  cartItems   CartItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Supplier {
  id            String    @id @default(cuid())
  name          String
  province      String?
  categories    String[]  @default([])
  contactPerson String?
  email         String?
  wechat        String?
  whatsapp      String?
  terms         String?
  rating        String?
  notes         String?
  active        Boolean   @default(true)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Order {
  id                String          @id @default(cuid())
  number            String          @unique
  customerId        String?
  // Dados do cliente no momento da compra (também para convidados)
  customerName      String
  customerEmail     String
  customerPhone     String
  customerNif       String?
  isGuest           Boolean         @default(false)
  channel           OrderChannel    @default(WEB)
  conversationId    String?
  conversation      Conversation?   @relation(fields: [conversationId], references: [id])
  notifications     Notification[]
  status            OrderStatus     @default(AWAITING_PAYMENT)
  shippingMode      String          @default("sea_lcl")
  deliveryMethod    String          @default("pickup")
  deliveryAddress   Json?
  subtotalAoa       Decimal         @db.Decimal(14, 2)
  freightAoa        Decimal         @default(0) @db.Decimal(14, 2)
  insuranceAoa      Decimal         @default(0) @db.Decimal(14, 2)
  deliveryFeeAoa    Decimal         @default(0) @db.Decimal(14, 2)
  totalAoa          Decimal         @db.Decimal(14, 2)
  estimatedDelivery String?
  shipmentId        String?
  shipment          Shipment?       @relation(fields: [shipmentId], references: [id])
  customer          Customer?       @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  documents         OrderDocument[]
  trackingEvents    TrackingEvent[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerEmail])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  title        String
  image        String?
  quantity     Int
  unitPriceAoa Decimal @db.Decimal(14, 2)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  method        String
  provider      String
  reference     String?
  transactionId String?       @unique
  phone         String?
  status        PaymentStatus @default(PENDING)
  amountAoa     Decimal       @db.Decimal(14, 2)
  // Comprovativo de transferência (ficheiro guardado fora da pasta pública)
  proofPath       String?
  proofFileName   String?
  proofMimeType   String?
  proofSize       Int?
  proofUploadedAt DateTime?
  rejectionReason String?
  reviewedBy    String?
  reviewedAt    DateTime?
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Lote de envio do agente parceiro (aéreo ou marítimo)
model Shipment {
  id             String          @id @default(cuid())
  code           String          @unique
  title          String
  agentReference String?
  status         ShipmentStatus  @default(DRAFT)
  statusLabel    String?
  transportMode  TransportMode
  origin         String
  destination    String          @default("Luanda (Angola)")
  departedAt     DateTime?
  etaAt          DateTime?
  volumeWeight   String?
  orders         Order[]
  events         TrackingEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TrackingEvent {
  id          String    @id @default(cuid())
  orderId     String?
  shipmentId  String?
  status      String
  label       String
  note        String?
  location    String?
  responsible String?
  occurredAt  DateTime  @default(now())
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment    Shipment? @relation(fields: [shipmentId], references: [id])
}

// Configurações editáveis (prazos, taxas, dados bancários)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Carrinho do cliente com sessão (permite retomar noutro dispositivo e medir carrinhos abandonados)
model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

// Mensagens enviadas aos clientes (WhatsApp / e-mail). Sem fornecedor configurado ficam como SIMULATED.
model Notification {
  id                String              @id @default(cuid())
  orderId           String?
  order             Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  channel           NotificationChannel
  recipient         String
  event             String
  subject           String?
  body              String
  status            NotificationStatus
  providerMessageId String?
  error             String?
  createdAt         DateTime            @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// Conversa WhatsApp com um número. "history" guarda o histórico da sessão actual
// no formato da API Claude (só se acrescenta; nova sessão após 24h sem mensagens).
model Conversation {
  id               String                @id @default(cuid())
  phone            String                @unique
  profileName      String?
  status           ConversationStatus    @default(BOT)
  handoffReason    String?
  history          Json                  @default("[]")
  sessionStartedAt DateTime              @default(now())
  lastMessageAt    DateTime              @default(now())
  unreadForStaff   Int                   @default(0)
  messages         ConversationMessage[]
  orders           Order[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String       // IN | OUT
  author         String       // CUSTOMER | BOT | STAFF | SYSTEM
  text           String
  waMessageId    String?      @unique
  deliveryStatus String?      // SENT | FAILED | SIMULATED
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Documentos anexados pela equipa a uma encomenda (visíveis ao cliente no rastreio)
model OrderDocument {
  id           String   @id @default(cuid())
  orderId      String
  name         String
  fileName     String
  path         String
  mimeType     String
  size         Int
  uploadedById String?
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
