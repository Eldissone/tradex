DATABASE_URL="postgresql://tradex:change-me-in-development@localhost:5432/tradex?schema=public"
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5174

# Configuração da Conta de Administrador do Backoffice
ADMIN_EMAIL=admin@tradex.ao
ADMIN_PASSWORD=tradexadmin2026
ADMIN_FIRST_NAME=Carlos
ADMIN_LAST_NAME=Viana
ADMIN_PHONE=+244 912 345 678

# Autenticação (JWT) — gere um valor aleatório longo, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Conta cliente de demonstração criada pelo seed (apenas desenvolvimento)
SEED_DEMO_CUSTOMER_EMAIL=cliente@tradex.ao
SEED_DEMO_CUSTOMER_PASSWORD=tradex2026

# Webhook de pagamentos (deixe vazio para desativar)
PAYMENT_WEBHOOK_SECRET=

# Endereço público da loja (links nas mensagens)
PUBLIC_SITE_URL=http://localhost:5174

# WhatsApp Business Cloud API (deixe vazio para simular os envios)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
# Nome do modelo aprovado pela Meta para avisos de encomenda (3 parâmetros: nome, encomenda, mensagem)
WHATSAPP_TEMPLATE_ORDER_UPDATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT

# E-mail (SMTP) — deixe vazio para simular
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TradeX Global <no-reply@tradex.ao>

# Assistente IA no WhatsApp (sem chave: as conversas vão directamente para a equipa)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
